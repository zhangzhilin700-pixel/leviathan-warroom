"""
利維坦王國 - 戰情室中樞 v2.0
精簡版：無重複定義，心理學顧問 + 防禦系統
"""

from flask import Flask, render_template, jsonify, request
import psutil
import time
import requests
from commands import run_system_command
from psychology_advisor import get_advisor

app = Flask(__name__)

# ========== 心理學顧問初始化 ==========
advisor = get_advisor()

# ========== 防禦狀態變數 ==========
_defense_mode = "NORMAL"
_last_analysis = {}

def get_defense_mode():
    global _defense_mode
    return _defense_mode

def set_defense_mode(mode):
    global _defense_mode
    _defense_mode = mode
    print(f"🛡️ 防禦模式已設定: {mode}")

def update_defense_from_analysis(result):
    global _last_analysis, _defense_mode
    _last_analysis = result
    try:
        stress = result.get('stress_level', 'low')
        fatigue_str = result.get('fatigue_risk', '0%')
        fatigue = int(fatigue_str.replace('%', ''))
        if stress in ['high', 'very_high'] or fatigue > 70:
            set_defense_mode('WARNING')
    except:
        pass

# ========== 系統監控函數 ==========
def get_disk_io():
    try:
        disk_io = psutil.disk_io_counters()
        if disk_io:
            read_speed = disk_io.read_bytes / 1024 / 1024
            write_speed = disk_io.write_bytes / 1024 / 1024
            return f"讀:{read_speed:.1f}MB/s 寫:{write_speed:.1f}MB/s"
    except:
        pass
    return "0.00 B/s"

def call_ollama(prompt, model='qwen2.5:7b'):
    try:
        response = requests.post('http://localhost:11434/api/generate',
                                json={'model': model, 'prompt': prompt, 'stream': False, 'temperature': 0.5},
                                timeout=45)
        if response.status_code == 200:
            return response.json().get('response', '模型無回應')
    except Exception as e:
        print(f"[DEBUG] Ollama 錯誤: {e}")
    return "AI 服務暫時不可用"

# ========== Flask 路由 ==========
@app.route('/')
def index():
    return render_template('index.html')

@app.route('/api/system_stats')
def system_stats():
    stats = {
        'cpu': psutil.cpu_percent(interval=1),
        'memory': psutil.virtual_memory().percent,
        'disk_io': get_disk_io(),
        'timestamp': time.time()
    }
    return jsonify(stats)

@app.route('/api/llm_status')
def llm_status():
    try:
        response = requests.get('http://localhost:11434/api/tags', timeout=3)
        if response.status_code == 200:
            return jsonify({'status': 'online'})
    except:
        pass
    return jsonify({'status': 'offline'})

@app.route('/api/chat', methods=['POST'])
def chat():
    data = request.get_json()
    user_msg = data.get('message', '')
    
    system_result = run_system_command(user_msg)
    if system_result:
        return jsonify({'sender': '利維坦', 'reply': system_result})
    
    prompt = f"你是利維坦，王國中樞。簡短回應：{user_msg}"
    reply = call_ollama(prompt)
    return jsonify({'sender': '利維坦', 'reply': reply})

# ========== 心理學顧問路由 ==========
@app.route('/api/psychology/analyze', methods=['POST'])
def psychology_analyze():
    data = request.get_json()
    cmd_freq = data.get('cmd_frequency', 25)
    time_of_day = data.get('time_of_day', '下午')
    response_time = data.get('response_time', 3.5)
    
    result = advisor.analyze_behavior(cmd_freq, time_of_day, response_time)
    update_defense_from_analysis(result)
    
    return jsonify({'status': 'success', 'analysis': result, 'defense_mode': get_defense_mode()})

# ========== 防禦系統路由 ==========
@app.route('/api/defense/status', methods=['GET'])
def defense_status():
    return jsonify({
        'defense_mode': get_defense_mode(),
        'last_analysis': _last_analysis
    })

@app.route('/api/defense/override', methods=['POST'])
def defense_override():
    data = request.get_json()
    mode = data.get('mode', 'NORMAL')
    if mode in ['NORMAL', 'WARNING', 'LOCKDOWN']:
        set_defense_mode(mode)
        return jsonify({'status': 'success', 'defense_mode': mode})
    return jsonify({'status': 'error', 'message': '無效模式'}), 400

if __name__ == '__main__':
    app.run(host='127.0.0.1', port=5002, debug=True)

# ========== 視覺哨兵路由 ==========
import base64
import os

@app.route('/api/vision', methods=['POST'])
def vision_analyze():
    """分析上傳的圖片"""
    data = request.get_json()
    image_path = data.get('image_path', '')
    
    if not image_path or not os.path.exists(image_path):
        return jsonify({'error': '圖片不存在'}), 400
    
    # 讀取圖片並轉為 base64
    with open(image_path, 'rb') as f:
        img_b64 = base64.b64encode(f.read()).decode()
    
    # 呼叫 llava 模型
    try:
        response = requests.post('http://localhost:11434/api/generate',
                                json={
                                    'model': 'llava:latest',
                                    'prompt': '請詳細描述這張圖片的內容',
                                    'images': [img_b64],
                                    'stream': False
                                },
                                timeout=60)
        if response.status_code == 200:
            result = response.json().get('response', '分析失敗')
            return jsonify({'status': 'success', 'analysis': result})
    except Exception as e:
        print(f"視覺分析錯誤: {e}")
    
    return jsonify({'status': 'error', 'message': '視覺分析失敗'}), 500

