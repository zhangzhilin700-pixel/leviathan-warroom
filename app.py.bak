import traceback

@app.route('/api/upload_vision', methods=['POST'])
def upload_vision_safe():
    try:
        if 'image' not in request.files:
            return jsonify({'error': '沒有上傳圖片'}), 400
        
        file = request.files['image']
        if file.filename == '':
            return jsonify({'error': '未選擇檔案'}), 400
        
        # 簡化測試：先不呼叫 llava，直接回傳成功
        return jsonify({'status': 'success', 'analysis': '圖片已收到，分析功能開發中'})
    except Exception as e:
        error_msg = traceback.format_exc()
        print(error_msg)
        return jsonify({'status': 'error', 'message': str(e), 'traceback': error_msg}), 500

@app.route('/api/upload_vision', methods=['POST'])
def upload_vision():
    try:
        if 'image' not in request.files:
            return jsonify({'error': '沒有上傳圖片'}), 400
        
        file = request.files['image']
        if file.filename == '':
            return jsonify({'error': '未選擇檔案'}), 400
        
        return jsonify({'status': 'success', 'analysis': '圖片已收到，視覺分析功能開發中'})
    except Exception as e:
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/api/upload_vision', methods=['POST'])
def upload_vision():
    try:
        if 'image' not in request.files:
            return jsonify({'error': '沒有上傳圖片'}), 400
        
        file = request.files['image']
        if file.filename == '':
            return jsonify({'error': '未選擇檔案'}), 400
        
        # 簡化測試：先回傳成功
        return jsonify({'status': 'success', 'analysis': f'已收到圖片：{file.filename}，視覺分析功能開發中'})
    except Exception as e:
        return jsonify({'status': 'error', 'message': str(e)}), 500
